// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// ================================================================================================
//  GTE V7 GOLD OPT - strategy version of "Gold Trend Engine V7 - Structure Matrix"
//
//  Exactly the same structure engine as the indicator :
//      swing pivots -> break of structure -> BULL / BEAR entry
//      order block of the impulse is used for the stop loss
//      exit : take profit (R multiple) , stop loss , or opposite signal ("Close BUY" / "Close SELL")
//  Optional multi timeframe filter so trades are only taken with the scalping trend.
// ================================================================================================
//@version=5
strategy("GTE V7 GOLD OPT", "GTE V7 OPT", overlay = true,
     default_qty_type = strategy.fixed, default_qty_value = 1,
     initial_capital = 10000, currency = currency.USD,
     commission_type = strategy.commission.cash_per_contract, commission_value = 0.0,
     pyramiding = 0, calc_on_every_tick = false,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ------------------------------------------------------------------------------------------------
//                                            INPUTS
// ------------------------------------------------------------------------------------------------
G_STR = "1  Market Structure  /  بنية السوق"
G_OB  = "2  Order Blocks  /  مناطق العرض والطلب"
G_TRD = "3  Trade Management  /  إدارة الصفقة"
G_FIL = "4  Filters  /  الفلاتر"

swingLen  = input.int(8, "Swing length", minval = 1, maxval = 100, group = G_STR)
useClose  = input.bool(true, "Confirm the break with the candle close", group = G_STR)
shiftOnly = input.bool(true, "Trade only trend shifts (CHoCH)", group = G_STR,
     tooltip = "On = one trade per reversal, Off = every break of structure is traded.")
bullCol   = input.color(#2e9e5b, "Bull", inline = "sc", group = G_STR)
bearCol   = input.color(#e0332f, "Bear", inline = "sc", group = G_STR)

obShow    = input.bool(true, "Draw the order block of the entry", group = G_OB)
obSource  = input.string("Wick", "Zone size", options = ["Wick", "Body"], group = G_OB)
obMax     = input.int(5, "Max zones per side", minval = 1, maxval = 25, group = G_OB)

slMode    = input.string("Order block", "Stop loss", options = ["Order block", "ATR"], group = G_TRD)
slBufTick = input.int(20, "Stop buffer (ticks)", minval = 0, group = G_TRD)
atrLen    = input.int(14, "ATR length", minval = 1, group = G_TRD)
atrMult   = input.float(1.5, "ATR multiplier", minval = 0.1, step = 0.1, group = G_TRD)
rr        = input.float(2.0, "Take profit (R multiple)", minval = 0.1, step = 0.1, group = G_TRD)
useBE     = input.bool(true, "Move the stop to break even at 1R", group = G_TRD)
closeOpp  = input.bool(true, "Close on the opposite signal", group = G_TRD)

useMtf    = input.bool(false, "Only trade with the scalping trend", group = G_FIL,
     tooltip = "Longs need the three fast timeframes bullish, shorts need them bearish.")
mtfLen    = input.int(5, "Swing length inside each timeframe", minval = 1, group = G_FIL)
tf1       = input.timeframe("1", "TF 1", inline = "t1", group = G_FIL)
tf2       = input.timeframe("3", "TF 2", inline = "t1", group = G_FIL)
tf3       = input.timeframe("5", "TF 3", inline = "t1", group = G_FIL)
useSess   = input.bool(false, "Session filter", group = G_FIL)
sess      = input.session("0300-2100", "Session", group = G_FIL)
sessTz    = input.string("UTC", "Timezone", group = G_FIL)
maxPerDay = input.int(0, "Max trades per day (0 = unlimited)", minval = 0, group = G_FIL)

// ------------------------------------------------------------------------------------------------
//                                        MARKET STRUCTURE
// ------------------------------------------------------------------------------------------------
atr = nz(ta.atr(atrLen), nz(ta.tr, syminfo.mintick * 10))

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float swHigh  = na
var bool  hiTaken = true
var float swLow   = na
var bool  loTaken = true

if not na(ph)
    swHigh  := ph
    hiTaken := false

if not na(pl)
    swLow   := pl
    loTaken := false

float srcUp = useClose ? close : high
float srcDn = useClose ? close : low

bool rawBull = not na(swHigh) and not hiTaken and srcUp > swHigh
bool rawBear = not na(swLow)  and not loTaken and srcDn < swLow

var int trend = 0
bool bullSig = false
bool bearSig = false

if rawBull
    bullSig := shiftOnly ? trend <= 0 : true
    trend   := 1
    hiTaken := true

if rawBear
    bearSig := shiftOnly ? trend >= 0 : true
    trend   := -1
    loTaken := true

// ------------------------------------------------------------------------------------------------
//                                    ORDER BLOCK OF THE IMPULSE
// ------------------------------------------------------------------------------------------------
f_baseOffset(bool bull) =>
    int idx = 0
    int lim = int(math.min(100, bar_index))
    if lim > 0
        for i = 1 to lim
            bool isBase = bull ? close[i] < open[i] : close[i] > open[i]
            if isBase
                idx := i
                break
    idx

var array<box> obBoxes = array.new<box>()

float obTop = na
float obBot = na

if rawBull or rawBear
    bool  isBull = rawBull
    int   off    = f_baseOffset(isBull)
    float zTop   = obSource == "Wick" ? high[off] : math.max(open[off], close[off])
    float zBot   = obSource == "Wick" ? low[off]  : math.min(open[off], close[off])
    if zTop > zBot
        obTop := zTop
        obBot := zBot
        if obShow
            color bd = isBull ? bullCol : bearCol
            array.push(obBoxes, box.new(bar_index - off, zTop, bar_index + 12, zBot,
                 border_color = color.new(bd, 45), bgcolor = color.new(bd, 80)))
            while array.size(obBoxes) > obMax * 2
                box.delete(array.shift(obBoxes))

// ------------------------------------------------------------------------------------------------
//                                       MULTI TIMEFRAME FILTER
// ------------------------------------------------------------------------------------------------
f_tfTrend() =>
    float pHi = ta.pivothigh(high, mtfLen, mtfLen)
    float pLo = ta.pivotlow(low, mtfLen, mtfLen)
    var float hh = na
    var float ll = na
    var int   d  = 0
    hh := na(pHi) ? hh : pHi
    ll := na(pLo) ? ll : pLo
    if not na(hh) and close > hh
        d := 1
    if not na(ll) and close < ll
        d := -1
    d

t1 = request.security(syminfo.tickerid, tf1, f_tfTrend(), lookahead = barmerge.lookahead_off)
t2 = request.security(syminfo.tickerid, tf2, f_tfTrend(), lookahead = barmerge.lookahead_off)
t3 = request.security(syminfo.tickerid, tf3, f_tfTrend(), lookahead = barmerge.lookahead_off)

bool mtfLong  = not useMtf or (t1 > 0 and t2 > 0 and t3 > 0)
bool mtfShort = not useMtf or (t1 < 0 and t2 < 0 and t3 < 0)

// ------------------------------------------------------------------------------------------------
//                                            FILTERS
// ------------------------------------------------------------------------------------------------
bool inSession = not useSess or not na(time(timeframe.period, sess, sessTz))

var int tradesToday = 0
if ta.change(time("1D")) != 0
    tradesToday := 0

bool dayOk = maxPerDay == 0 or tradesToday < maxPerDay

bool longOk  = bullSig and mtfLong  and inSession and dayOk
bool shortOk = bearSig and mtfShort and inSession and dayOk

// ------------------------------------------------------------------------------------------------
//                                        TRADE MANAGEMENT
// ------------------------------------------------------------------------------------------------
float buf = slBufTick * syminfo.mintick

var float longSL  = na
var float longTP  = na
var float shortSL = na
var float shortTP = na
var float entryPx = na

if longOk
    float sl = slMode == "ATR" ? close - atr * atrMult : nz(obBot, nz(swLow, low)) - buf
    sl := math.min(sl, close - syminfo.mintick)
    float risk = close - sl
    longSL  := sl
    longTP  := close + risk * rr
    entryPx := close
    if closeOpp and strategy.position_size < 0
        strategy.close("BEAR", comment = "Close SELL")
    strategy.entry("BULL", strategy.long, comment = "BULL")
    tradesToday += 1

if shortOk
    float sl = slMode == "ATR" ? close + atr * atrMult : nz(obTop, nz(swHigh, high)) + buf
    sl := math.max(sl, close + syminfo.mintick)
    float risk = sl - close
    shortSL := sl
    shortTP := close - risk * rr
    entryPx := close
    if closeOpp and strategy.position_size > 0
        strategy.close("BULL", comment = "Close BUY")
    strategy.entry("BEAR", strategy.short, comment = "BEAR")
    tradesToday += 1

// break even management
if useBE and strategy.position_size > 0 and not na(longSL) and not na(entryPx)
    float oneR = entryPx - longSL
    if oneR > 0 and high >= entryPx + oneR
        longSL := math.max(longSL, entryPx)

if useBE and strategy.position_size < 0 and not na(shortSL) and not na(entryPx)
    float oneR = shortSL - entryPx
    if oneR > 0 and low <= entryPx - oneR
        shortSL := math.min(shortSL, entryPx)

if strategy.position_size > 0
    strategy.exit("Gold TP", from_entry = "BULL", limit = longTP, stop = longSL, comment_profit = "Gold TP", comment_loss = "Gold SL")

if strategy.position_size < 0
    strategy.exit("Gold TP", from_entry = "BEAR", limit = shortTP, stop = shortSL, comment_profit = "Gold TP", comment_loss = "Gold SL")

// ------------------------------------------------------------------------------------------------
//                                            VISUALS
// ------------------------------------------------------------------------------------------------
plotshape(longOk,  "BULL entry", shape.labelup,   location.belowbar, bullCol, text = "BULL", textcolor = color.white, size = size.small)
plotshape(shortOk, "BEAR entry", shape.labeldown, location.abovebar, bearCol, text = "BEAR", textcolor = color.white, size = size.small)

plot(strategy.position_size > 0 ? longSL : strategy.position_size < 0 ? shortSL : na, "Stop loss",
     color = color.new(bearCol, 20), style = plot.style_linebr)
plot(strategy.position_size > 0 ? longTP : strategy.position_size < 0 ? shortTP : na, "Take profit",
     color = color.new(bullCol, 20), style = plot.style_linebr)
