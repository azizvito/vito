// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// ================================================================================================
//  Gold Trend Engine V7 - Structure Matrix   (GTE V7)
//
//  1. Market structure : swing pivots, BOS / CHoCH, BULL - BEAR labels + swing dots
//  2. Order blocks     : supply / demand zones, 50% dashed mid line, grey when mitigated
//  3. Liquidity        : equal highs / equal lows levels with their price printed
//  4. Trend matrix     : multi timeframe bias table (1 / 3 / 5 / 10 / 15 / 25 min)
//  5. Bid / Ask panel  : sell - buy prices with the spread in points
// ================================================================================================
//@version=5
indicator("Gold Trend Engine V7 - Structure Matrix", "GTE V7", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ------------------------------------------------------------------------------------------------
//                                            INPUTS
// ------------------------------------------------------------------------------------------------
G_STR = "1  Market Structure  /  بنية السوق"
G_OB  = "2  Order Blocks  /  مناطق العرض والطلب"
G_LIQ = "3  Liquidity  EQH / EQL  /  السيولة"
G_TBL = "4  Trend Matrix  /  مصفوفة الاتجاه"
G_PAN = "5  Bid / Ask Panel  /  لوحة البيع والشراء"

// ---- structure ----
swingLen  = input.int(8, "Swing length", minval = 1, maxval = 100, group = G_STR,
     tooltip = "Number of bars on each side of a swing point. Smaller = more signals.")
useClose  = input.bool(true, "Confirm the break with the candle close", group = G_STR)
shiftOnly = input.bool(false, "Signal only on a trend shift (CHoCH)", group = G_STR,
     tooltip = "Off = every break of structure (BOS) prints a label, On = only reversals.")
showSig   = input.bool(true,  "BULL / BEAR labels", group = G_STR)
showDot   = input.bool(true,  "Dot on the swing point", group = G_STR)
showHalo  = input.bool(false, "Highlight circle around the signal", group = G_STR)
showSwPx  = input.bool(true, "Print the price of every swing point", group = G_STR)
maxSig    = input.int(40, "Keep last N signals", minval = 1, maxval = 120, group = G_STR)
swPxCol   = input.color(color.new(#b2b5be, 25), "Swing price colour", group = G_STR)
bullCol   = input.color(#2e9e5b, "Bull", inline = "sc", group = G_STR)
bearCol   = input.color(#e0332f, "Bear", inline = "sc", group = G_STR)
haloCol   = input.color(color.new(#ff9800, 65), "Circle", inline = "sc", group = G_STR)

// ---- order blocks ----
obShow      = input.bool(true, "Show order blocks", group = G_OB)
obMax       = input.int(5, "Max zones per side", minval = 1, maxval = 25, group = G_OB)
obSource    = input.string("Wick", "Zone size", options = ["Wick", "Body"], group = G_OB)
obMitig     = input.string("Close", "Mitigated by", options = ["Close", "Wick"], group = G_OB)
obExtendSty = input.string("Until mitigated", "Extend to the right",
     options = ["Until mitigated", "Fixed bars"], group = G_OB)
obExtendBar = input.int(50, "Fixed extension (bars)", minval = 1, maxval = 500, group = G_OB)
obShowMid   = input.bool(true, "50% dashed line", group = G_OB)
obShowPrice = input.bool(true, "Print the zone price", group = G_OB)
obKeepDead  = input.bool(true, "Keep mitigated zones (grey)", group = G_OB)
obBullCol   = input.color(color.new(#2e9e5b, 78), "Demand", inline = "oc", group = G_OB)
obBearCol   = input.color(color.new(#e0332f, 78), "Supply", inline = "oc", group = G_OB)
obDeadCol   = input.color(color.new(#9e9e9e, 82), "Mitigated", inline = "oc", group = G_OB)

// ---- liquidity ----
liqShow  = input.bool(true, "Show equal highs / lows", group = G_LIQ)
liqTol   = input.float(0.10, "Tolerance (x ATR)", minval = 0.01, maxval = 2.0, step = 0.01, group = G_LIQ)
liqMax   = input.int(12, "Keep last N levels", minval = 1, maxval = 60, group = G_LIQ)
liqPrice = input.bool(true, "Print the price on the level", group = G_LIQ)
liqCol   = input.color(color.new(#b2b5be, 20), "Level colour", group = G_LIQ)

// ---- trend matrix ----
tblShow = input.bool(true, "Show the trend matrix", group = G_TBL)
tblLang = input.string("English", "Language", options = ["English", "Arabic"], group = G_TBL)
tblPos  = input.string("Top right", "Position",
     options = ["Top right", "Top left", "Middle right", "Middle left", "Bottom right", "Bottom left"], group = G_TBL)
tblSize = input.string("Small", "Text size", options = ["Tiny", "Small", "Normal", "Large"], group = G_TBL)
mtfLen  = input.int(5, "Swing length used inside each timeframe", minval = 1, maxval = 50, group = G_TBL)
tf1 = input.timeframe("1",  "TF 1", inline = "t1", group = G_TBL)
tf2 = input.timeframe("3",  "TF 2", inline = "t1", group = G_TBL)
tf3 = input.timeframe("5",  "TF 3", inline = "t2", group = G_TBL)
tf4 = input.timeframe("10", "TF 4", inline = "t2", group = G_TBL)
tf5 = input.timeframe("15", "TF 5", inline = "t3", group = G_TBL)
tf6 = input.timeframe("25", "TF 6", inline = "t3", group = G_TBL)

// ---- bid / ask panel ----
panShow   = input.bool(true, "Show the bid / ask panel", group = G_PAN)
panSpread = input.float(0.30, "Spread (price units)", minval = 0.0, step = 0.01, group = G_PAN,
     tooltip = "Pine Script has no access to the broker feed, so the spread of your account is entered here.")

isArabic = tblLang == "Arabic"

// ------------------------------------------------------------------------------------------------
//                                            TYPES
// ------------------------------------------------------------------------------------------------
type Zone
    box   bx
    line  mid
    float top
    float bot
    bool  bull
    bool  dead

// ------------------------------------------------------------------------------------------------
//                                        MARKET STRUCTURE
// ------------------------------------------------------------------------------------------------
atr = nz(ta.atr(200), nz(ta.tr, syminfo.mintick * 10))

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float swHigh   = na      // last swing high that is still valid
var int   swHighBr = na      // its bar index
var bool  hiTaken  = true    // has it already been broken
var float swLow    = na
var int   swLowBr  = na
var bool  loTaken  = true

var float prevPH   = na      // previous swing high, used for equal highs
var int   prevPHBr = na
var float prevPL   = na
var int   prevPLBr = na

var array<line>  liqLines = array.new<line>()
var array<label> liqTexts = array.new<label>()
var array<label> sigDraws = array.new<label>()
var array<label> swTexts  = array.new<label>()
var array<Zone>  zones    = array.new<Zone>()

// ---- a fresh swing high ----
if not na(ph)
    if liqShow and not na(prevPH) and math.abs(ph - prevPH) <= atr * liqTol
        float y  = math.avg(ph, prevPH)
        line  ln = line.new(prevPHBr, y, bar_index - swingLen, y, color = liqCol, style = line.style_dotted, width = 1)
        array.push(liqLines, ln)
        if liqPrice
            label tx = label.new(int(math.avg(prevPHBr, bar_index - swingLen)), y,
                 str.tostring(y, format.mintick), style = label.style_none,
                 textcolor = liqCol, size = size.tiny, yloc = yloc.price)
            array.push(liqTexts, tx)
    if showSwPx
        array.push(swTexts, label.new(bar_index - swingLen, ph, str.tostring(ph, format.mintick),
             style = label.style_none, textcolor = swPxCol, size = size.tiny, yloc = yloc.price))
    prevPH   := ph
    prevPHBr := bar_index - swingLen
    swHigh   := ph
    swHighBr := bar_index - swingLen
    hiTaken  := false

// ---- a fresh swing low ----
if not na(pl)
    if liqShow and not na(prevPL) and math.abs(pl - prevPL) <= atr * liqTol
        float y  = math.avg(pl, prevPL)
        line  ln = line.new(prevPLBr, y, bar_index - swingLen, y, color = liqCol, style = line.style_dotted, width = 1)
        array.push(liqLines, ln)
        if liqPrice
            label tx = label.new(int(math.avg(prevPLBr, bar_index - swingLen)), y,
                 str.tostring(y, format.mintick), style = label.style_none,
                 textcolor = liqCol, size = size.tiny, yloc = yloc.price)
            array.push(liqTexts, tx)
    if showSwPx
        array.push(swTexts, label.new(bar_index - swingLen, pl, str.tostring(pl, format.mintick),
             style = label.style_none, textcolor = swPxCol, size = size.tiny, yloc = yloc.price))
    prevPL   := pl
    prevPLBr := bar_index - swingLen
    swLow    := pl
    swLowBr  := bar_index - swingLen
    loTaken  := false

// ---- keep the amount of liquidity drawings under control ----
while array.size(liqLines) > liqMax
    line.delete(array.shift(liqLines))
while array.size(liqTexts) > liqMax
    label.delete(array.shift(liqTexts))
while array.size(swTexts) > maxSig * 2
    label.delete(array.shift(swTexts))

// ---- break of structure ----
float srcUp = useClose ? close : high
float srcDn = useClose ? close : low

bool rawBull = not na(swHigh) and not hiTaken and srcUp > swHigh
bool rawBear = not na(swLow)  and not loTaken and srcDn < swLow

var int trend = 0
bool bullSig = false
bool bearSig = false

if rawBull
    bullSig := shiftOnly ? trend <= 0 : true
    trend   := 1
    hiTaken := true

if rawBear
    bearSig := shiftOnly ? trend >= 0 : true
    trend   := -1
    loTaken := true

// ------------------------------------------------------------------------------------------------
//                                    SIGNALS  (BULL / BEAR)
// ------------------------------------------------------------------------------------------------
// origin of the move = the swing point the impulse started from
f_originBar(bool bull) =>
    int raw = bull ? swLowBr : swHighBr
    int res = na(raw) or raw >= bar_index ? bar_index - 1 : raw
    int(math.max(math.max(res, bar_index - 400), 0))

f_originPrice(bool bull) =>
    float raw = bull ? swLow : swHigh
    na(raw) ? (bull ? low : high) : raw

if showSig and (bullSig or bearSig)
    bool  isBull = bullSig
    int   oBar   = f_originBar(isBull)
    float oPx    = f_originPrice(isBull)
    color c      = isBull ? bullCol : bearCol
    float pad    = atr * 0.35

    if showHalo
        array.push(sigDraws, label.new(oBar, oPx, "", style = label.style_circle, color = haloCol,
             size = size.large, yloc = yloc.price))
    if showDot
        array.push(sigDraws, label.new(oBar, oPx, "", style = label.style_circle, color = c,
             size = size.tiny, yloc = yloc.price))
    array.push(sigDraws, label.new(oBar, isBull ? oPx - pad : oPx + pad, isBull ? "BULL" : "BEAR",
         style = isBull ? label.style_label_up : label.style_label_down,
         color = c, textcolor = color.white, size = size.small, yloc = yloc.price))

    while array.size(sigDraws) > maxSig * 3
        label.delete(array.shift(sigDraws))

// ------------------------------------------------------------------------------------------------
//                                        ORDER BLOCKS
// ------------------------------------------------------------------------------------------------
// the last opposite candle before the impulse becomes the zone
f_baseOffset(bool bull) =>
    int idx = 0
    int lim = int(math.min(100, bar_index))
    if lim > 0
        for i = 1 to lim
            bool isBase = bull ? close[i] < open[i] : close[i] > open[i]
            if isBase
                idx := i
                break
    idx

if obShow and (rawBull or rawBear)
    bool  isBull = rawBull
    int   off    = f_baseOffset(isBull)
    float zTop   = obSource == "Wick" ? high[off] : math.max(open[off], close[off])
    float zBot   = obSource == "Wick" ? low[off]  : math.min(open[off], close[off])

    if zTop > zBot
        color bg  = isBull ? obBullCol : obBearCol
        color bd  = isBull ? bullCol : bearCol
        int   x1  = bar_index - off
        int   x2  = obExtendSty == "Fixed bars" ? bar_index + obExtendBar : bar_index + 1
        float mid = math.avg(zTop, zBot)

        box b = box.new(x1, zTop, x2, zBot, border_color = color.new(bd, 45), border_width = 1,
             bgcolor = bg, text = obShowPrice ? str.tostring(mid, format.mintick) : "",
             text_size = size.tiny, text_color = color.new(color.white, 25),
             text_halign = text.align_left, text_valign = text.align_center)

        line m = na
        if obShowMid
            m := line.new(x1, mid, x2, mid, color = color.new(bd, 25), style = line.style_dashed, width = 1)

        array.push(zones, Zone.new(bx = b, mid = m, top = zTop, bot = zBot, bull = isBull, dead = false))

        // never keep more than obMax live zones per side
        int cnt = 0
        if array.size(zones) > 0
            for i = array.size(zones) - 1 to 0
                Zone z = array.get(zones, i)
                if z.bull == isBull
                    cnt += 1
                    if cnt > obMax
                        box.delete(z.bx)
                        if not na(z.mid)
                            line.delete(z.mid)
                        array.remove(zones, i)

// ---- per bar maintenance : extension, mitigation, tap detection ----
bool tapDemand = false
bool tapSupply = false

if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        if not z.dead
            bool hitByClose = z.bull ? close < z.bot : close > z.top
            bool hitByWick  = z.bull ? low   < z.bot : high  > z.top
            bool hit = obMitig == "Close" ? hitByClose : hitByWick
            if hit
                z.dead := true
                if obKeepDead
                    box.set_bgcolor(z.bx, obDeadCol)
                    box.set_border_color(z.bx, color.new(#9e9e9e, 45))
                    if not na(z.mid)
                        line.set_color(z.mid, color.new(#9e9e9e, 35))
                else
                    box.delete(z.bx)
                    if not na(z.mid)
                        line.delete(z.mid)
                    array.remove(zones, i)
            else
                if obExtendSty == "Until mitigated"
                    box.set_right(z.bx, bar_index + 1)
                    if not na(z.mid)
                        line.set_x2(z.mid, bar_index + 1)
                if z.bull and low <= z.top and low[1] > z.top
                    tapDemand := true
                if not z.bull and high >= z.bot and high[1] < z.bot
                    tapSupply := true

// ------------------------------------------------------------------------------------------------
//                                        TREND MATRIX
// ------------------------------------------------------------------------------------------------
// same structure engine, evaluated inside every requested timeframe
f_tfTrend() =>
    float pHi = ta.pivothigh(high, mtfLen, mtfLen)
    float pLo = ta.pivotlow(low, mtfLen, mtfLen)
    var float hh = na
    var float ll = na
    var int   d  = 0
    hh := na(pHi) ? hh : pHi
    ll := na(pLo) ? ll : pLo
    if not na(hh) and close > hh
        d := 1
    if not na(ll) and close < ll
        d := -1
    d

t1 = request.security(syminfo.tickerid, tf1, f_tfTrend(), lookahead = barmerge.lookahead_off)
t2 = request.security(syminfo.tickerid, tf2, f_tfTrend(), lookahead = barmerge.lookahead_off)
t3 = request.security(syminfo.tickerid, tf3, f_tfTrend(), lookahead = barmerge.lookahead_off)
t4 = request.security(syminfo.tickerid, tf4, f_tfTrend(), lookahead = barmerge.lookahead_off)
t5 = request.security(syminfo.tickerid, tf5, f_tfTrend(), lookahead = barmerge.lookahead_off)
t6 = request.security(syminfo.tickerid, tf6, f_tfTrend(), lookahead = barmerge.lookahead_off)

f_tfName(simple string tf) =>
    string res = tf
    if not na(str.tonumber(tf))
        res := isArabic ? "دقيقة " + tf : tf + (tf == "1" ? " Minute" : " Minutes")
    res

f_trendTxt(int d) =>
    isArabic ? (d > 0 ? "صاعد" : d < 0 ? "هابط" : "محايد") : (d > 0 ? "Bullish" : d < 0 ? "Bearish" : "Neutral")

f_trendCol(int d) =>
    d > 0 ? bullCol : d < 0 ? bearCol : color.new(color.gray, 20)

tablePos = tblPos == "Top left" ? position.top_left : tblPos == "Middle right" ? position.middle_right : tblPos == "Middle left" ? position.middle_left : tblPos == "Bottom right" ? position.bottom_right : tblPos == "Bottom left" ? position.bottom_left : position.top_right

txtSize = tblSize == "Tiny" ? size.tiny : tblSize == "Normal" ? size.normal : tblSize == "Large" ? size.large : size.small

var table matrix = na
if tblShow and barstate.islast
    if na(matrix)
        matrix := table.new(tablePos, 2, 8, border_width = 1, border_color = color.new(color.gray, 40),
             frame_width = 1, frame_color = color.new(color.gray, 40))

    color hdrBg = color.new(#2a2e39, 10)
    table.cell(matrix, 0, 0, isArabic ? "نظرة السكالبينج" : "Scalping View", bgcolor = hdrBg,
         text_color = color.new(color.white, 0), text_size = txtSize)
    table.cell(matrix, 1, 0, isArabic ? "اتجاه الفريمات" : "Timeframe Trend", bgcolor = hdrBg,
         text_color = color.new(color.white, 0), text_size = txtSize)
    table.cell(matrix, 0, 1, isArabic ? "الفريم" : "Timeframe", bgcolor = hdrBg,
         text_color = color.new(color.white, 20), text_size = txtSize)
    table.cell(matrix, 1, 1, isArabic ? "الاتجاه" : "Trend", bgcolor = hdrBg,
         text_color = color.new(color.white, 20), text_size = txtSize)

    array<string> names  = array.from(f_tfName(tf1), f_tfName(tf2), f_tfName(tf3), f_tfName(tf4), f_tfName(tf5), f_tfName(tf6))
    array<int>    trends = array.from(t1, t2, t3, t4, t5, t6)

    for i = 0 to 5
        int d = array.get(trends, i)
        table.cell(matrix, 0, i + 2, array.get(names, i), bgcolor = color.new(#1e222d, 10),
             text_color = color.new(color.white, 0), text_size = txtSize)
        table.cell(matrix, 1, i + 2, f_trendTxt(d), bgcolor = color.new(f_trendCol(d), 82),
             text_color = f_trendCol(d), text_size = txtSize)

// ------------------------------------------------------------------------------------------------
//                                      BID / ASK PANEL
// ------------------------------------------------------------------------------------------------
var table panel = na
if panShow and barstate.islast
    if na(panel)
        panel := table.new(position.top_left, 3, 2, border_width = 1, border_color = color.new(color.gray, 60))

    float bid = close
    float ask = close + panSpread
    int   pts = int(math.round(panSpread / syminfo.mintick))

    table.cell(panel, 0, 0, str.tostring(bid, format.mintick), bgcolor = bearCol,
         text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 1, isArabic ? "بيع" : "Sell", bgcolor = bearCol,
         text_color = color.new(color.white, 25), text_size = size.tiny)
    table.cell(panel, 1, 0, str.tostring(pts), bgcolor = color.new(#1e222d, 10),
         text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 1, isArabic ? "نقطة" : "pts", bgcolor = color.new(#1e222d, 10),
         text_color = color.new(color.white, 25), text_size = size.tiny)
    table.cell(panel, 2, 0, str.tostring(ask, format.mintick), bgcolor = #2962ff,
         text_color = color.white, text_size = size.small)
    table.cell(panel, 2, 1, isArabic ? "شراء" : "Buy", bgcolor = #2962ff,
         text_color = color.new(color.white, 25), text_size = size.tiny)

// ------------------------------------------------------------------------------------------------
//                                           ALERTS
// ------------------------------------------------------------------------------------------------
alertcondition(bullSig, "GTE V7 - BULL signal", "GTE V7 : BULL structure shift on {{ticker}} {{interval}} @ {{close}}")
alertcondition(bearSig, "GTE V7 - BEAR signal", "GTE V7 : BEAR structure shift on {{ticker}} {{interval}} @ {{close}}")
alertcondition(tapDemand, "GTE V7 - Demand zone tapped", "GTE V7 : price tapped a demand zone on {{ticker}} {{interval}}")
alertcondition(tapSupply, "GTE V7 - Supply zone tapped", "GTE V7 : price tapped a supply zone on {{ticker}} {{interval}}")
alertcondition(bullSig and t1 > 0 and t2 > 0 and t3 > 0, "GTE V7 - BULL with aligned scalping trend",
     "GTE V7 : BULL signal while the 3 fastest timeframes are bullish on {{ticker}}")
alertcondition(bearSig and t1 < 0 and t2 < 0 and t3 < 0, "GTE V7 - BEAR with aligned scalping trend",
     "GTE V7 : BEAR signal while the 3 fastest timeframes are bearish on {{ticker}}")

// values exposed to the data window / other scripts
plot(trend, "Structure trend", display = display.data_window)
plot(t1, "TF1 trend", display = display.data_window)
plot(t2, "TF2 trend", display = display.data_window)
plot(t3, "TF3 trend", display = display.data_window)
plot(t4, "TF4 trend", display = display.data_window)
plot(t5, "TF5 trend", display = display.data_window)
plot(t6, "TF6 trend", display = display.data_window)
