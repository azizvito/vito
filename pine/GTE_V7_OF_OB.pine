tablePosFrom() =>
    switch tblPos
        "Top Left" => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left" => position.bottom_left
        => position.top_right

var table hud = table.new(tablePosFrom(), 2, 8, bgcolor = #000000, border_color = #ffffff, border_width = 1, frame_color = #ffffff, frame_width = 1)

tfTxt(int s) =>
    na(s) or s == 0 ? (tblLang == "Arabic" ? "محايد" : "Neutral") : s == 1 ? (tblLang == "Arabic" ? "صاعد" : "Bullish") : (tblLang == "Arabic" ? "هابط" : "Bearish")

tfCol(int s) =>
    na(s) or s == 0 ? color.gray : s == 1 ? #00e676 : #ff5252

if showTable and barstate.islast
    table.cell(hud, 0, 0, tblLang == "Arabic" ? "تجاه الفريمات بجدول السكالب" : "Scalping View Timeframe Trend", text_color = color.white, text_size = tblSz, bgcolor = #111111)
    table.cell(hud, 1, 0, "", text_color = color.white, text_size = tblSz, bgcolor = #111111)
    table.cell(hud, 0, 1, tblLang == "Arabic" ? "الفريم" : "Timeframe", text_color = color.white, text_size = tblSz, bgcolor = #1a1a1a)
    table.cell(hud, 1, 1, tblLang == "Arabic" ? "الاتجاه" : "Trend", text_color = color.white, text_size = tblSz, bgcolor = #1a1a1a)
    string n0 = tblLang == "Arabic" ? "دقيقة 1" : "1 Minute"
    string n1 = tblLang == "Arabic" ? "دقائق 3" : "3 Minutes"
    string n2 = tblLang == "Arabic" ? "دقائق 5" : "5 Minutes"
    string n3 = tblLang == "Arabic" ? "دقائق 10" : "10 Minutes"
    string n4 = tblLang == "Arabic" ? "دقيقة 15" : "15 Minutes"
    string n5 = tblLang == "Arabic" ? "دقيقة 25" : "25 Minutes"
    table.cell(hud, 0, 2, n0, text_color = color.white, text_size = tblSz, bgcolor = #000000)
    table.cell(hud, 1, 2, tfTxt(st1), text_color = tfCol(st1), text_size = tblSz, bgcolor = #000000)
    table.cell(hud, 0, 3, n1, text_color = color.white, text_size = tblSz, bgcolor = #000000)
    table.cell(hud, 1, 3, tfTxt(st3), text_color = tfCol(st3), text_size = tblSz, bgcolor = #000000)
    table.cell(hud, 0, 4, n2, text_color = color.white, text_size = tblSz, bgcolor = #000000)
    table.cell(hud, 1, 4, tfTxt(st5), text_color = tfCol(st5), text_size = tblSz, bgcolor = #000000)
    table.cell(hud, 0, 5, n3, text_color = color.white, text_size = tblSz, bgcolor = #000000)
    table.cell(hud, 1, 5, tfTxt(st10), text_color = tfCol(st10), text_size = tblSz, bgcolor = #000000)
    table.cell(hud, 0, 6, n4, text_color = color.white, text_size = tblSz, bgcolor = #000000)
    table.cell(hud, 1, 6, tfTxt(st15), text_color = tfCol(st15), text_size = tblSz, bgcolor = #000000)
    table.cell(hud, 0, 7, n5, text_color = color.white, text_size = tblSz, bgcolor = #000000)
    table.cell(hud, 1, 7, tfTxt(st25), text_color = tfCol(st25), text_size = tblSz, bgcolor = #000000)

alertcondition(newBull, "BULL trend state", "GTE V7 BULL")
alertcondition(newBear, "BEAR trend state", "GTE V7 BEAR")
